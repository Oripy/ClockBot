#include <Arduino.h>
#include <U8g2lib.h>
#include <Wire.h>

// U8g2 SW I2C Constructor - forces explicit pin communication:
// U8G2_SSD1306_128X64_NONAME_F_SW_I2C(rotation, clock_pin, data_pin, [reset_pin])
U8G2_SSD1306_128X64_NONAME_F_HW_I2C u8g2(U8G2_R0, /* reset=*/ U8X8_PIN_NONE, /* clock=*/ 2, /* data=*/ 1);

void setup() {
  Serial.begin(115200);
  delay(1000);
  Serial.println("[TEST] Starting OLED Screen Test...");

  // Initialize the screen hardware
  u8g2.begin();
  Serial.println("[TEST] Screen initialized!");
}

void loop() {
  // Clear the internal buffer
  u8g2.clearBuffer();          

  // Draw a border frame around the screen edges
  u8g2.drawFrame(0, 0, 128, 64);

  // Choose a clean, easy-to-read font
  u8g2.setFont(u8g2_font_ncenB14_tr); 

  // Draw our status strings inside the box
  u8g2.drawStr(10, 30, "SCREEN");
  u8g2.drawStr(40, 52, "OK!");

  // Push the buffer to the physical screen
  u8g2.sendBuffer();          

  Serial.println("[TEST] Render loop active. Screen buffer pushed.");
  delay(2000);
}